<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Se a pasta dist existir e a requisição for para um arquivo dentro dela
  RewriteCond %{REQUEST_URI} ^/dist/ [NC]
  RewriteRule ^ - [L]

  # Se existir dist/index.html e o arquivo pedido existir em dist/
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # Se o arquivo ou diretório físico na raiz existir, serve normalmente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Se dist/index.html existir, serve dist/index.html para qualquer rota SPA
  RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
  RewriteRule ^.*$ dist/index.html [L]

  # Fallback relativo para dist se DOCUMENT_ROOT não estiver disponível
  RewriteCond dist/index.html -f
  RewriteRule ^(.*)$ dist/index.html [L]

  # Fallback padrão
  RewriteRule ^ index.html [L]
</IfModule>

# Controle de Cache Inteligente
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
</IfModule>

# Compressão GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
